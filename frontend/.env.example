# PeopleCore frontend — required environment variables.
# Copy this file to .env.local (or .env) and fill in the values from your
# Firebase project: Firebase Console → Project settings → Your apps → Web.

# Firebase web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL for the Express API. Leave empty in dev (the Vite dev server
# proxies /api to the backend); set to the deployed API origin in production.
VITE_API_BASE_URL=